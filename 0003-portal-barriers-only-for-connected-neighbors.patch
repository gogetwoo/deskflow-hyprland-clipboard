-    LOG_WARN("no input capture pointer barriers found");
+    // No side has a connected neighbor: switch capture off rather than leave
+    // the previous barrier set live. Barriers that fire with nowhere to send
+    // the cursor make the portal grab and release input in a tight loop.
+    LOG_DEBUG("no active input capture pointer barriers, disabling capture");
+    disable();
   }
