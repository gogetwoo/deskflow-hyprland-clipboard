diff --git i/src/lib/server/Server.cpp w/src/lib/server/Server.cpp
index 4d5465c..2420012 100644
--- i/src/lib/server/Server.cpp
+++ w/src/lib/server/Server.cpp
@@ -578,7 +578,25 @@ bool Server::hasAnyNeighbor(const BaseClientProxy *client, Direction dir) const
 {
   assert(client != nullptr);
 
-  return m_config->hasNeighbor(getName(client), dir);
+  // Only a neighbor that is connected right now counts. Platforms that capture
+  // input with pointer barriers (the XDG input-capture portal) grab input as
+  // soon as the cursor reaches an active edge; if nobody is connected there the
+  // server immediately releases it, the cursor is still on the edge, and the
+  // barrier fires again, flapping capture dozens of times a second.
+  const std::string name = getName(client);
+  if (!m_config->hasNeighbor(name, dir)) {
+    return false;
+  }
+  for (auto link = m_config->beginNeighbor(name); link != m_config->endNeighbor(name); ++link) {
+    if (link->first.getSide() != dir) {
+      continue;
+    }
+    const auto neighbor = m_config->getCanonicalName(link->second.getName());
+    if (neighbor != name && m_clients.contains(neighbor)) {
+      return true;
+    }
+  }
+  return false;
 }
 
